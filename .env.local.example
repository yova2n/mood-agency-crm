NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Service role key (SECRET — jamais côté client)
# Trouvable dans : Supabase Dashboard → Project Settings → API → service_role
# Utilisée pour la route /api/team/invite (invitation de nouveaux membres)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
